{
  "name": "@k3vndev/tw-animations",
  "version": "0.2.1",
  "description": "A lightweight set of customizable Tailwind CSS animations ready to drop into any project. Built for Tailwind v4+",
  "repository": {
    "type": "git",
    "url": "https://github.com/k3vndev/tw-animations.git"
  },
   "bugs": {
    "url": "https://github.com/k3vndev/tw-animations/issues"
  },
