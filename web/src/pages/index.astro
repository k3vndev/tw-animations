---
import Layout from '../Layout.astro'

const titleAnimation = 'anim-opacity-0 anim-blur-sm anim-ease-out-back'
---

<Layout>
  <main
    class='w-screen h-screen flex flex-col items-center justify-center gap-20'
  >
    <div class='flex flex-col items-center gap-2'>
      <h1
        class=`text-8xl text-white font-bold animate-slide-in-t anim-rotate-12 ${titleAnimation}`
      >
        Demo Page
      </h1>
      <h3
        class=`text-2xl text-green-300 anim-delay-200 animate-slide-in-l  ${titleAnimation}`
      >
        Not yet finished :(
      </h3>
    </div>
    <div
      class=`
				bg-green-300 size-64 rounded-2xl border-white/50 border-2
				animate-slide-in-b anim-slide-move-[20rem] anim-opacity-0 anim-blur-2xl anim-ease-out-back anim-duration-1000 anim-rotate-90
			`
    >
    </div>
  </main>
</Layout>
